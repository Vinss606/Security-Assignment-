# CareVault Python Security Configuration (.env.example)
APP_ENV=production
HTTPS_PORT=8443
HTTP_REDIRECT_PORT=8080

# Cryptographic Session & CSRF Secrets (64-hex chars / 256-bit minimum)
SESSION_HMAC_SECRET=replace-with-64-char-cryptographic-random-hex-in-production
MFA_ENCRYPTION_KEY=replace-with-64-char-aes-256-gcm-hex-key-in-production

# Authentication & Lockout Thresholds
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
SESSION_TTL_MINUTES=30

# TLS / PKI Paths
TLS_CA_CERT_PATH=./certs/carevault-root-ca.crt
TLS_SERVER_CERT_PATH=./certs/carevault-server.crt
TLS_SERVER_KEY_PATH=./certs/carevault-server.key
